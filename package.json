{
    "name": "dev-process-manager",
    "license": "BSD-2-Clause",
    "version": "4.0.0",
    "keywords": [
        "process-manager",
        "dev-server",
        "cli",
        "monorepo",
        "development",
        "task-runner",
        "process",
        "orchestration"
    ],
    "exports": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "bin": {
        "dev-pm": "lib/dev-pm.js"
    },
    "files": [
        "lib/**/*",
        "skills/**/*"
    ],
    "scripts": {
        "build": "tsc",
        "build-and-publish": "npm run build && npx changeset publish",
        "lint": "run-p lint:eslint lint:tsc",
        "lint:eslint": "eslint src/",
        "lint:tsc": "tsc",
        "prepare": "husky",
        "start": "tsc --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "build-and-publish": "npm run build && npx changeset publish",
        "version": "changeset version && npm install"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vivid-planet/dev-process-manager.git"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "author": "Vivid Planet Software GmbH <office@vivid-planet.com> (https://www.vivid-planet.com/)",
    "bugs": {
        "url": "https://github.com/vivid-planet/dev-process-manager/issues"
    },
    "homepage": "https://dev-process-manager.com/",
    "dependencies": {
        "cli-table3": "^0.6.5",
        "colors": "^1.4.0",
        "commander": "^15.0.0",
        "dotenv": "^17.4.2",
        "dotenv-expand": "^13.0.0",
        "log-update": "^8.0.0",
        "pidtree": "^1.0.0",
        "pidusage": "^4.0.1",
        "pretty-bytes": "^7.1.1",
        "unconfig": "^7.5.0",
        "wait-on": "^9.1.0"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@dextinity/eslint-config": "^10.0.1",
        "@types/node": "^24.13.3",
        "@types/pidusage": "^2.0.5",
        "@types/wait-on": "^5.3.4",
        "eslint": "^9.39.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=22"
    },
    "type": "module"
}
